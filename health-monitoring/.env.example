# Copy to .env and fill in. Generate secrets with:  python scripts/gen_secrets.py
APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://health:CHANGE_ME@localhost:5432/health
REDIS_URL=redis://localhost:6379/0

# 256-bit key, base64/hex. NEVER commit a real value.
HEALTH_ENCRYPTION_KEY=CHANGE_ME
ACTIVE_KEY_VERSION=1
# Optional: older versions kept for decryption during rotation, e.g. {"1":"<old key>"}
HEALTH_ENCRYPTION_KEYS_PREVIOUS=
# Optional: JSON key file for hot rotation (overrides the two vars above), e.g. /run/secrets/health_keys.json
HEALTH_ENCRYPTION_KEYS_FILE=
KEY_REFRESH_SECONDS=60

# Bearer tokens
HEALTH_API_TOKEN=CHANGE_ME     # detailed /health + live dashboard
CRAWLER_WS_TOKEN=CHANGE_ME     # crawler -> /ws/health

HEARTBEAT_INTERVAL_SECONDS=20
HEARTBEAT_TTL_SECONDS=40
HEARTBEAT_MAX_AGE_SECONDS=300
CRAWLER_UNHEALTHY_AFTER_SECONDS=300

DATABASE_TIMEOUT_SECONDS=1
REDIS_TIMEOUT_SECONDS=1
HEALTH_BUDGET_SECONDS=1.8

PUBLIC_HEALTH_ENDPOINT=false

MONITOR_ENABLED=true
MONITOR_PUSH_INTERVAL_SECONDS=3

# Crawler client
HEALTH_WS_URL=ws://localhost:8000/api/v1/ws/health
WORKER_ID=cw-1

# docker-compose only (compose refuses to start if unset)
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
