# Copy this to .env and fill in real values. 

# Redis -- heartbeat cache
REDIS_URL=redis://localhost:6379/0
HEARTBEAT_TTL_SECONDS=90
HEARTBEAT_STALE_AFTER_SECONDS=60

# Replay protection window (seconds)
REPLAY_WINDOW_SECONDS=300

# AES-256-GCM key, as 64 hex characters (32 bytes). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
HEALTH_AES_KEY_V1=
HEALTH_AES_KEY_ACTIVE_VERSION=v1

# Database (used by GET /api/v1/health's connectivity check)
DATABASE_URL=
DB_CHECK_TIMEOUT_SECONDS=2.0

# WebSocket server
WS_HOST=0.0.0.0
WS_PORT=8001
