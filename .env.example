# Copy to .env and load it before starting the service.
# Generate: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
HEALTH_SHARED_KEY_B64=REPLACE_WITH_BASE64_32_BYTE_KEY
# PostgreSQL async URL example:
DATABASE_URL=postgresql+asyncpg://health_user:CHANGE_ME@127.0.0.1:5432/darktrace
# Optional. If omitted, in-memory TTL store is used for local development.
REDIS_URL=redis://127.0.0.1:6379/0
HEARTBEAT_INTERVAL_SECONDS=20
HEARTBEAT_TTL_SECONDS=60
HEARTBEAT_FRESHNESS_SECONDS=60
MAX_HEARTBEAT_AGE_SECONDS=300
HEALTH_WS_URL=ws://127.0.0.1:8000/api/v1/ws/health
WORKER_ID=cw-local-01
QUEUE_DEPTH=0
