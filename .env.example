HEALTH_DATABASE_DSN=postgresql://darktrace:darktrace@localhost:5432/darktrace
HEALTH_DATABASE_CHECK_TIMEOUT_SECONDS=1.5

HEALTH_REDIS_URL=redis://localhost:6379/2
HEALTH_HEARTBEAT_CACHE_KEY_PREFIX=health:crawler:heartbeat:

HEALTH_HEARTBEAT_INTERVAL_SECONDS=20
HEALTH_HEARTBEAT_TTL_MULTIPLIER=2
HEALTH_HEARTBEAT_FRESHNESS_SECONDS=30

HEALTH_REPLAY_WINDOW_SECONDS=300

HEALTH_AES_KEY_ENV_PREFIX=AES_KEY_
HEALTH_ACTIVE_AES_KEY_VERSION_ENV=ACTIVE_AES_KEY_VERSION
HEALTH_DEFAULT_AES_KEY_VERSION=v1

AES_KEY_V1=replace-with-base64-encoded-32-byte-key
ACTIVE_AES_KEY_VERSION=v1

HEALTH_DETAILED_REQUIRES_AUTH=false
HEALTH_API_KEY=replace-with-a-long-random-secret

HEALTH_RESPONSE_LATENCY_BUDGET_SECONDS=2.0

HEALTH_WEBSOCKET_URL=wss://localhost:8000/api/v1/ws/health
HEALTH_CRAWLER_WORKER_ID=cw-local
HEALTH_CRAWLER_RECONNECT_BACKOFF_SECONDS=5.0
